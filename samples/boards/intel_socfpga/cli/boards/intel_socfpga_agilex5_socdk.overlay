/* The overlay file should be used to enable any
 * dts nodes required by this application for this
 * board.
 */

&qspi {
	status = "okay";

	/*
	 * Raw core.rbf for HPS-driven fabric load (board farm / faster than SD).
	 * High in the 256MiB MT25QU02G to stay clear of typical boot images.
	 * Adjust if your JIC layout collides with this region.
	 */
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		bitstream_partition: partition@e000000 {
			label = "bitstream";
			reg = <0x0e000000 DT_SIZE_M(32)>;
		};
	};
};

&sdmmc {
	status = "okay";

	mmc {
		/*SD Disk Access */
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&timer2 {
	status = "okay";
};

&timer3 {
	status = "okay";
};

&dma0 {
	status = "okay";
};

&dma1 {
	status = "okay";
};

&sip_smc {
	status = "okay";
	zephyr,num-clients = <5>;
};

&fpga_config {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&watchdog0 {
	status = "okay";
};