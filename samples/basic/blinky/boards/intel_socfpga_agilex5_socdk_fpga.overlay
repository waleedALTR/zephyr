/*
 * This overlay remaps the default 'led0' alias to the FPGA PIO LED,
 * allowing the generic blinky sample to exercise the gpio_altera_pio
 * driver without modifying the application or the board's default
 * devicetree.
 */

&fpga_pio_led0 {
	status = "okay";
};

/ {
    aliases {
        led0 = &pio_led0;
    };
};
