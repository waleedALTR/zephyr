/*
 * Remap led0 to the FPGA PIO LED. Soft-IP is a child of fpga0 so bridge
 * on/off owns deferred init.
 */

/ {
	aliases {
		led0 = &pio_led0;
	};

	leds {
		compatible = "gpio-leds";

		pio_led0: pio_led0 {
			gpios = <&fpga_pio_led0 0 GPIO_ACTIVE_HIGH>;
			label = "FPGA Fabric PIO LED 0";
		};
	};
};

&fpga0 {
	status = "okay";

	fpga_pio_led0: led_pio@20010080 {
		compatible = "altr,pio-1.0";
		reg = <0x20010080 0x20>;
		direction = "output";
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
		zephyr,deferred-init;
	};
};
