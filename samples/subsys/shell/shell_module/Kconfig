mainmenu "Shell module sample application"

menu "Application configuration"

config SHELL_FOREGROUND_CMDS
	bool "Shell foreground commands example"
	default y

config SHELL_DYNAMIC_CMDS
	bool "Shell dynamic commands example"
	default y

choice SHELL_MODULE_STORAGE
	prompt "Storage backend"
	default SHELL_MODULE_STORAGE_NAND if DT_HAS_CDNS_NAND_ENABLED
	default SHELL_MODULE_STORAGE_SDMMC
	help
	  Prefer NAND when Cadence NAND is enabled in DT; otherwise enable
	  the SDMMC disk and filesystem shell stack.

config SHELL_MODULE_STORAGE_NAND
	bool "NAND flash"
	select DISK_ACCESS
	select DISK_DRIVER_FTL if DT_HAS_ZEPHYR_FTL_DHARA_ENABLED && ZEPHYR_DHARA_MODULE
	select FILE_SYSTEM
	select FAT_FILESYSTEM_ELM
	select FILE_SYSTEM_SHELL
	select FILE_SYSTEM_SHELL_MOUNT_COMMAND
	help
	  Use Cadence NAND with Dhara FTL disk (/NAND:) and the FAT
	  filesystem shell. Requires zephyr,ftl-dhara in DT and the
	  dhara west module (west update dhara).

config SHELL_MODULE_STORAGE_SDMMC
	bool "SDMMC"
	select DISK_ACCESS
	select SDHC
	select DISK_DRIVER_SDMMC
	select FILE_SYSTEM
	select FAT_FILESYSTEM_ELM
	select FILE_SYSTEM_SHELL
	select FILE_SYSTEM_SHELL_MOUNT_COMMAND
	help
	  Enable SDMMC disk access and the FAT filesystem shell.

endchoice

endmenu

if SHELL_MODULE_STORAGE_NAND
config FS_FATFS_CUSTOM_MOUNT_POINT_COUNT
	int
	default 1

config FS_FATFS_CUSTOM_MOUNT_POINTS
	string
	default "NAND"
endif

source "Kconfig.zephyr"
