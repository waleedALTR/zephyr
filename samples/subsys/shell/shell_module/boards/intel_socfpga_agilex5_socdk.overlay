&xgmac2 {
	status = "okay";
};

&mdio2 {
	status = "okay";
};

&phy0 {
	status = "okay";
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&timer2 {
	status = "okay";
};

&timer3 {
	status = "okay";
};

&watchdog0 {
	status = "okay";
};

&dma0 {
	status = "okay";
};

&dma1 {
	status = "okay";
};

&sip_smc {
	status = "okay";
	zephyr,num-clients = <5>;
};

&fpga_config {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i3c0 {
	status = "disabled";

	lps22hh0: lps22hh@FB1122330001 {
		compatible = "st,lps22hh";
		reg = <0x00 0xFB11 0x22330001>;
		odr = <1>;
		status = "disabled";
	};

	lps22hh1: lps22hh@FB1122330002 {
		compatible = "st,lps22hh";
		reg = <0x00 0xFB11 0x22330002>;
		odr = <1>;
		status = "disabled";
	};

	lps22hh2: lps22hh@500000000000000050 { /* i2c device */
		compatible = "st,lps22hh";
		reg = <0x50 0x0 0x50>;
		status = "disabled";
	};
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&i2c4 {
	status = "okay";
};

&dma1 {
	status = "okay";
};

&sip_smc {
	status = "okay";
	zephyr,num-clients = <5>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i3c0 {
	status = "disabled";

	lps22hh0: lps22hh@FB1122330001 {
		compatible = "st,lps22hh";
		reg = <0x00 0xFB11 0x22330001>;
		odr = <1>;
		status = "disabled";
	};

	lps22hh1: lps22hh@FB1122330002 {
		compatible = "st,lps22hh";
		reg = <0x00 0xFB11 0x22330002>;
		odr = <1>;
		status = "disabled";
	};

	lps22hh2: lps22hh@500000000000000050 { /* i2c device */
		compatible = "st,lps22hh";
		reg = <0x50 0x0 0x50>;
		status = "disabled";
	};
};

/*
 * GHRD fabric soft-IP (LW HPS). Lifecycle follows fpga0 soft-ip /
 * bridge on-off via zephyr,deferred-init.
 */
/ {
	aliases {
		sw0 = &button0;
	};

	fpga_pio_led0: pio_led0@20010080 {
		compatible = "altr,pio-1.0";
		reg = <0x20010080 0x20>;
		direction = "output";
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
		zephyr,deferred-init;
	};

	fpga_pio_button0: pio_button@20010060 {
		compatible = "altr,pio-1.0";
		reg = <0x20010060 0x20>;
		direction = "input";
		interrupt-parent = <&gic>;
		/*
		 * fpga2hps_interrupt_irq0[0]: TRM irqS=17, GIC INTID=49.
		 * Zephyr GIC_SPI uses irqS (SPI index).
		 */
		interrupts = <GIC_SPI 17 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
		zephyr,deferred-init;
	};

	leds {
		compatible = "gpio-leds";

		pio_led0: pio_led0 {
			gpios = <&fpga_pio_led0 0 GPIO_ACTIVE_HIGH>;
			label = "FPGA Fabric PIO LED 0";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&fpga_pio_button0 0 GPIO_ACTIVE_LOW>;
			label = "FPGA Button";
		};
	};
};

&fpga0 {
	soft-ip = <&fpga_pio_led0 &fpga_pio_button0>;
};
