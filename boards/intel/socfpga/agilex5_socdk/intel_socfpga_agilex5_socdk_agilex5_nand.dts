/dts-v1/;

#include "intel_socfpga_agilex5_socdk_common.dtsi"

/ {
	model = "Intel SoC FPGA Agilex5 NAND daughter board";
	compatible = "intel,socfpga-agilex5-socdk-nand", "intel,socfpga-agilex5";

	chosen {
		/* Image slots for MCUboot. The NAND is not memory mapped and
		 * nothing is linked to it.
		 */
		zephyr,flash = &nand;
		zephyr,flash-controller = &nand;
		zephyr,uart-mcumgr = &uart0;
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		nand = &nand;
	};

	leds {
		compatible = "gpio-leds";

		led0: led0 {
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
		};

		led1: led1 {
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
		};
	};
};

&qspi {
	status = "okay";

	flash0: flash@0 {
		compatible = "micron,mt25qu02g";
		reg = <0>;
		size = <DT_SIZE_M(256*8)>; /* in bits */
		sector-size = <65536>;
		subsector-size = <4096>;
		page-size = <256>;
		address-byte = <2>;
		bytes-per-block = <16>;
		status = "okay";
	};
};

&nand {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* TF-A FIP, read from 0x200000 when TF-A boots from NAND. Its BL33
		 * is MCUboot. Block 10 (0xa00000), right after it, is bad on the
		 * SoC DK.
		 */
		boot_partition: partition@200000 {
			label = "fip";
			reg = <0x00200000 DT_SIZE_M(8)>;
		};

		/* MCUboot image slots, sized for the 7 MiB an application is
		 * loaded to. Raw NAND: a bad block is not skipped.
		 */
		slot0_partition: partition@b00000 {
			label = "image-0";
			reg = <0x00b00000 DT_SIZE_M(8)>;
		};

		slot1_partition: partition@1300000 {
			label = "image-1";
			reg = <0x01300000 DT_SIZE_M(8)>;
		};

		nand_storage_partition: partition@1b00000 {
			label = "storage";
			reg = <0x01b00000 0xfe500000>;
		};
	};
};

/ {
	ftl {
		compatible = "zephyr,ftl-dhara";
		partition = <&nand_storage_partition>;
		disk-name = "NAND";
		/* Must be >= NAND page size (often 8 KiB or 16 KiB). */
		buffer-size = <16384>;
	};
};

&xgmac0 {
	full-duplex-mode-en;
	num-dma-ch = <1>;
	num-tx-queues = <1>;
	num-rx-queues = <1>;
	num-tc = <1>;
	dma-ch-rdrl = <128>;
	dma-ch-tdrl = <128>;
	max-speed = <1000>;
	max-frame-size = <9018>;
	jumbo-pkt-en;
	zephyr,random-mac-address;
	phy-handle = <&phy0>;
};

&mdio0 {
	csr-clock-indx = <4>;

	phy0: phy@0 {
		compatible = "ethernet-phy";
		reg = <0>;
	};
};
