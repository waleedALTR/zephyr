/dts-v1/;

#include "intel_socfpga_agilex5_socdk_common.dtsi"

/ {
	model = "Intel SoC FPGA Agilex5";
	compatible = "intel,socfpga-agilex5";

	aliases {
		led0 = &led0;
	};

	leds {
		compatible = "gpio-leds";

		led0: led0 {
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
		};
		
		pio_led0: pio_led0 {
			gpios = <&fpga_pio_led0 0 GPIO_ACTIVE_HIGH>;
			label = "FPGA Fabric PIO LED 0";
		};
	};
};

&sdmmc {
	status = "okay";

	mmc {
		/*SD Disk Access */
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

&qspi {
	status = "okay";

	flash0: flash@0 {
		compatible = "micron,mt25qu02g";
		reg = <0>;
		size = <DT_SIZE_M(256*8)>; /* in bits */
		sector-size = <65536>;
		subsector-size = <4096>;
		page-size = <256>;
		address-byte = <2>;
		bytes-per-block = <16>;
		status = "okay";
	};
};

&xgmac2 {
	full-duplex-mode-en;
	num-dma-ch = <1>;
	num-tx-queues = <1>;
	num-rx-queues = <1>;
	num-tc = <1>;
	dma-ch-rdrl = <128>;
	dma-ch-tdrl = <128>;
	max-speed = <1000>;
	max-frame-size = <9018>;
	jumbo-pkt-en;
	zephyr,random-mac-address;
	phy-handle = <&phy0>;
};

&mdio2 {
	csr-clock-indx = <4>;

	phy0: phy@0 {
		compatible = "ethernet-phy";
		reg = <0>;
	};
};

&qspi {
	flash0: flash@0 {
		compatible = "micron,mt25qu02g";
		reg = <0>;
		size = <DT_SIZE_M(256*8)>; /* in bits */
		sector-size = <65536>;
		subsector-size = <4096>;
		page-size = <256>;
		address-byte = <2>;
		bytes-per-block = <16>;
		status = "okay";
	};
};

&nand {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		nand_fip_partition: partition@0 {
			label = "fip";
			reg = <0x0 DT_SIZE_M(10)>;
		};

		nand_storage_partition: partition@a00000 {
			label = "storage";
			reg = <0x00a00000 0xff600000>;
		};
	};
};

/ {
	ftl {
		compatible = "zephyr,ftl-dhara";
		partition = <&nand_storage_partition>;
		disk-name = "NAND";
		buffer-size = <8192>;
	};
};
