/dts-v1/;

#include <intel/intel_socfpga_agilex5.dtsi>

/ {
	compatible = "intel,socfpga-agilex5";
	model = "Intel SoC FPGA Agilex5";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &mem0;
	};

	aliases {
		led0 = &led0;
	};

	leds {
		compatible = "gpio-leds";

		led0: led0 {
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
		};
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&sdmmc {
	status = "okay";

	mmc {
		/*SD Disk Access */
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

&uart0 {
	current-speed = <115200>;
	status = "okay";
};

&xgmac0 {
	full-duplex-mode-en;
	num-dma-ch = <1>;
	num-tx-queues = <1>;
	num-rx-queues = <1>;
	num-tc = <1>;
	dma-ch-rdrl = <128>;
	dma-ch-tdrl = <128>;
	max-speed = <1000>;
	max-frame-size = <9018>;
	jumbo-pkt-en;
	phy-handle = <&phy0>;
	zephyr,random-mac-address;
};

&mdio0 {
	csr-clock-indx = <4>;

	phy0: phy@0 {
		compatible = "ethernet-phy";
		reg = <0>;
	};
};

&qspi {
	flash0: flash@0 {
		compatible = "micron,mt25qu02g";
		reg = <0>;
		size = <DT_SIZE_M(256*8)>; /* in bits */
		sector-size = <65536>;
		subsector-size = <4096>;
		page-size = <256>;
		address-byte = <2>;
		bytes-per-block = <16>;
		status = "okay";
	};
};
