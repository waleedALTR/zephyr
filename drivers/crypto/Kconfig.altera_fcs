config CRYPTO_ALTERA_FCS
	bool "Altera SoC FPGA FCS AES driver"
	default y
	depends on DT_HAS_ALTR_SOCFPGA_SDM_FCS_ENABLED
	depends on ALTERA_SDM
	select CACHE_MANAGEMENT if DCACHE
	help
	  Enable the AES ECB, CBC and CTR driver for the FPGA Crypto Service
	  (FCS) of the Secure Device Manager (SDM) of Altera SoC FPGAs, reached
	  through the SDM mailbox. Keys are imported into the SDM with
	  altera_fcs_import_key() and referenced by key ID.

if CRYPTO_ALTERA_FCS

config CRYPTO_ALTERA_FCS_MAX_SESSION
	int "Maximum number of FCS cipher sessions"
	default 2
	range 1 255
	help
	  Number of cipher sessions the driver can hold at the same time.

config CRYPTO_ALTERA_FCS_BUF_SIZE
	int "FCS data buffer size in bytes"
	default 4096
	range 64 1048576
	help
	  Size of each of the input and output buffers the SDM reads and
	  writes. Longer operations are split into several SDM requests.
	  Must be a multiple of 64.

endif # CRYPTO_ALTERA_FCS
