config ENTROPY_ALTERA_SDM
	bool "Altera SoC FPGA SDM random number generator"
	default y
	depends on DT_HAS_ALTR_SOCFPGA_SDM_RNG_ENABLED
	depends on ALTERA_SDM
	select ENTROPY_HAS_DRIVER
	help
	  Enable the entropy driver for the random number generator of the
	  Secure Device Manager (SDM) of Altera SoC FPGAs, read through the
	  SDM mailbox. The driver cannot be used from an ISR.

config ENTROPY_ALTERA_SDM_INIT_PRIORITY
	int "Altera SDM random number generator init priority"
	default 61
	depends on ENTROPY_ALTERA_SDM
	help
	  Must be higher (later) than CONFIG_ALTERA_SDM_INIT_PRIORITY, so the
	  SDM is ready when the driver initializes. The driver initializes at
	  the POST_KERNEL level.
